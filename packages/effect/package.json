{
  "name": "@zorsh/effect",
  "version": "0.0.0",
  "description": "Borsh binary codecs derived from native Effect 4 schemas, with inferred TypeScript types for Rust contract arguments and results.",
  "keywords": [
    "binary",
    "borsh",
    "codec",
    "effect",
    "near",
    "rust",
    "schema",
    "serialization",
    "typescript"
  ],
  "homepage": "https://github.com/r-near/zorsh/tree/main/packages/effect#readme",
  "bugs": {
    "url": "https://github.com/r-near/zorsh/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r-near/zorsh.git",
    "directory": "packages/effect"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Borsh": {
      "types": "./dist/Borsh.d.ts",
      "import": "./dist/Borsh.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test run",
    "prepublishOnly": "vp pack"
  },
  "devDependencies": {
    "effect": "4.0.5"
  },
  "peerDependencies": {
    "effect": "^4.0.5"
  }
}
