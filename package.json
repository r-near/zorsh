{
  "name": "zorsh-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vp -C packages/zorsh pack",
    "check": "vp check",
    "test": "vp test run",
    "check-package": "vp exec node scripts/check-package.mjs",
    "version-packages": "vp exec changeset version",
    "release": "vp run build && vp exec changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "26.5.1",
    "@vitest/coverage-v8": "5.0.5",
    "fast-check": "4.10.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.33.0"
}
