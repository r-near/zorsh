{
  "name": "@zorsh/zorsh",
  "version": "0.5.1",
  "description": "A TypeScript-first implementation of the Borsh binary serialization format, with a modern Zod-like API and full type inference.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r-near/zorsh.git"
  },
  "homepage": "https://github.com/r-near/zorsh#readme",
  "bugs": {
    "url": "https://github.com/r-near/zorsh/issues"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src"
  ],
  "packageManager": "bun@1.3.2",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "lefthook": "lefthook install",
    "check-exports": "attw --pack .",
    "release": "bun run build && changeset publish"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^2.4.9",
    "@changesets/cli": "^3.0.0",
    "@types/bun": "^1.3.2",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "fast-check": "^4.10.0",
    "lefthook": "^2.0.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}